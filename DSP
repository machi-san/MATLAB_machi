 t= 0:0.3:10
 y=sin(t)
 subplot(2,2,2)
 stem(t,y)
 xlabel('n')
 ylabel('x(n)')
 title('sine wave')
 
% generate impulse signal
 t= -4:1:4
 y= [zeros(1,4), ones(1,1), zeros(1,4)]
 subplot(2,2,3)
 stem(t,y)
 xlabel('n')
 ylabel('x(n)')
 title('impulse wave')

